{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Depurar cenário atual (Playwright)",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "-s",
          "-v",
          "--headed",
          "--slowmo",
          "500",
          "${file}"
        ],
        "python": "${command:python.interpreterPath}",
        "console": "integratedTerminal",
        "justMyCode": false
      }
    ]
}